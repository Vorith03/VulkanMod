#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer AnimationSource {
    uint words[];
} sourceData;

layout(set = 0, binding = 1, std430) buffer AnimationOutput {
    uint words[];
} outputData;

layout(push_constant) uniform InterpolationPushConstants {
    uint sourceBaseWord;
    uint sheetWidth;
    uint currentX;
    uint currentY;
    uint nextX;
    uint nextY;
    uint width;
    uint height;
    uint outputBaseWord;
    uint subFrame;
    uint duration;
    uint reserved;
} pc;

/*
 * Mirror Java 17 SpriteContents.InterpolationData exactly:
 *   weight = 1.0D - (double)subFrame / duration
 *   (int)(weight * current + (1.0D - weight) * next)
 *
 * "precise" requests SPIR-V NoContraction for the arithmetic chain so FMA or
 * reassociation cannot silently change the truncation boundary. Alpha is copied
 * from the current frame unchanged, matching the Forge 1.20.1 implementation.
 */
void main() {
    uint index = gl_GlobalInvocationID.x;
    // 0: original single-mip ABI; nonzero: original per-mip source table.
    // 0xffffffff: a bounded array of 12-word jobs stored in the disjoint
    // high end of shared scratch, with job index in workgroup Z.
    bool multi = pc.reserved == 0xffffffffu;
    uint job = gl_GlobalInvocationID.z;
    if(multi && job >= pc.duration) return;
    uint jobWord = pc.outputBaseWord + job * 12u;
    uint sourceBaseWord = multi ? outputData.words[jobWord] : pc.sourceBaseWord;
    uint currentX = multi ? outputData.words[jobWord + 1u] : pc.currentX;
    uint currentY = multi ? outputData.words[jobWord + 2u] : pc.currentY;
    uint nextX = multi ? outputData.words[jobWord + 3u] : pc.nextX;
    uint nextY = multi ? outputData.words[jobWord + 4u] : pc.nextY;
    uint outputBaseWord = multi ? outputData.words[jobWord + 7u] : pc.outputBaseWord;
    uint subFrame = multi ? outputData.words[jobWord + 8u] : pc.subFrame;
    uint duration = multi ? outputData.words[jobWord + 9u] : pc.duration;
    uint tableBase = multi ? outputData.words[jobWord + 10u] : pc.reserved;
    uint mip = gl_GlobalInvocationID.y;
    if(multi && mip >= outputData.words[jobWord + 11u]) return;
    bool fused = tableBase != 0u;
    uint row = tableBase + mip * 6u;
    uint width = fused ? sourceData.words[row + 2u] : pc.width;
    uint height = fused ? sourceData.words[row + 3u] : pc.height;
    uint pixelCount = width * height;
    if(index >= pixelCount || duration == 0u) return;
    uint sourceBase = fused ? sourceBaseWord + sourceData.words[row] : sourceBaseWord;
    uint sheetWidth = fused ? sourceData.words[row + 1u] : pc.sheetWidth;
    uint outputBase = fused ? outputBaseWord + sourceData.words[row + 4u] : outputBaseWord;
    uint shift = fused ? sourceData.words[row + 5u] : 0u;
    uint x = index % width;
    uint y = index / width;
    uint current = sourceData.words[sourceBase
            + ((currentY >> shift) + y) * sheetWidth + (currentX >> shift) + x];
    uint next = sourceData.words[sourceBase
            + ((nextY >> shift) + y) * sheetWidth + (nextX >> shift) + x];

    precise double fraction = double(subFrame) / double(duration);
    precise double currentWeight = 1.0 - fraction;
    precise double nextWeight = 1.0 - currentWeight;

    uint mixed = current & 0xff000000u;
    for(uint shift = 0u; shift < 24u; shift += 8u) {
        uint a = (current >> shift) & 255u;
        uint b = (next >> shift) & 255u;
        precise double currentTerm = currentWeight * double(a);
        precise double nextTerm = nextWeight * double(b);
        precise double value = currentTerm + nextTerm;
        mixed |= (uint(value) & 255u) << shift;
    }

    outputData.words[outputBase + index] = mixed;
}
