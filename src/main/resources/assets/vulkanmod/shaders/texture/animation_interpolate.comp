#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer AnimationSource {
    uint words[];
} sourceData;

layout(set = 0, binding = 1, std430) buffer AnimationOutput {
    uint words[];
} outputData;

layout(push_constant) uniform InterpolationPushConstants {
    uint sourceBaseWord;
    uint sheetWidth;
    uint currentX;
    uint currentY;
    uint nextX;
    uint nextY;
    uint width;
    uint height;
    uint outputBaseWord;
    uint subFrame;
    uint duration;
    uint reserved;
} pc;

/*
 * Mirror Java 17 SpriteContents.InterpolationData exactly:
 *   weight = 1.0D - (double)subFrame / duration
 *   (int)(weight * current + (1.0D - weight) * next)
 *
 * "precise" requests SPIR-V NoContraction for the arithmetic chain so FMA or
 * reassociation cannot silently change the truncation boundary. Alpha is copied
 * from the current frame unchanged, matching the Forge 1.20.1 implementation.
 */
void main() {
    uint index = gl_GlobalInvocationID.x;
    // reserved==0 retains the qualified legacy one-mip ABI. A nonzero
    // source-table word offset selects immutable per-mip rows, one workgroup-Y
    // plane per existing source mip. No mip generation or clock progression.
    uint mip = gl_GlobalInvocationID.y;
    bool fused = pc.reserved != 0u;
    uint row = pc.reserved + mip * 6u;
    uint width = fused ? sourceData.words[row + 2u] : pc.width;
    uint height = fused ? sourceData.words[row + 3u] : pc.height;
    uint pixelCount = width * height;
    if(index >= pixelCount || pc.duration == 0u)
        return;
    uint sourceBase = fused ? pc.sourceBaseWord + sourceData.words[row] : pc.sourceBaseWord;
    uint sheetWidth = fused ? sourceData.words[row + 1u] : pc.sheetWidth;
    uint outputBase = fused ? pc.outputBaseWord + sourceData.words[row + 4u] : pc.outputBaseWord;
    uint shift = fused ? sourceData.words[row + 5u] : 0u;
    uint x = index % width;
    uint y = index / width;
    uint current = sourceData.words[sourceBase
            + ((pc.currentY >> shift) + y) * sheetWidth + (pc.currentX >> shift) + x];
    uint next = sourceData.words[sourceBase
            + ((pc.nextY >> shift) + y) * sheetWidth + (pc.nextX >> shift) + x];

    precise double fraction = double(pc.subFrame) / double(pc.duration);
    precise double currentWeight = 1.0 - fraction;
    precise double nextWeight = 1.0 - currentWeight;

    uint mixed = current & 0xff000000u;
    for(uint shift = 0u; shift < 24u; shift += 8u) {
        uint a = (current >> shift) & 255u;
        uint b = (next >> shift) & 255u;
        precise double currentTerm = currentWeight * double(a);
        precise double nextTerm = nextWeight * double(b);
        precise double value = currentTerm + nextTerm;
        mixed |= (uint(value) & 255u) << shift;
    }

    outputData.words[outputBase + index] = mixed;
}
