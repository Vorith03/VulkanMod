#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer VoxelPage {
    uint words[];
} inputPage;

layout(set = 0, binding = 1, std430) buffer ProbeOutput {
    uint words[];
} outputData;

layout(set = 0, binding = 2, std430) readonly buffer ModelTable {
    uint words[];
} modelTable;

layout(push_constant) uniform ProbePushConstants {
    uint baseByteOffset;
    uint byteLength;
    uint modelTemplateCount;
} pc;

const uint MAGIC = 0x56584c31u;
const uint VERSION = 4u;
const uint BLOCK_COUNT = 4096u;
const uint PLANE_WORDS = 128u;
const uint FLAG_PLANES = 5u;
const uint SOLID_RENDER_PLANE = 0u;
const uint GPU_FULL_CUBE_PLANE = 4u;
const uint HALO_FACE_WORDS = 8u;
const uint HALO_WORDS = 48u;
const uint HEADER_WORDS = 4u;
const uint FACES_PER_VOXEL = 6u;
const uint VERTICES_PER_FACE = 4u;
const uint FACE_DESCRIPTOR_WORDS = BLOCK_COUNT * FACES_PER_VOXEL;
const uint COMPACT_DESCRIPTOR_BASE = HEADER_WORDS + FACE_DESCRIPTOR_WORDS;
const uint FACE_VERTEX_BASE = COMPACT_DESCRIPTOR_BASE + FACE_DESCRIPTOR_WORDS;
const uint FACE_VERTEX_WORDS = FACE_DESCRIPTOR_WORDS * VERTICES_PER_FACE;
const uint MODEL_FACE_RESULT_WORDS = 10u;
const uint MODEL_FACE_BASE = FACE_VERTEX_BASE + FACE_VERTEX_WORDS;

const uint MODEL_MAGIC = 0x47544d31u;
const uint MODEL_VERSION = 1u;
const uint MODEL_HEADER_WORDS = 8u;
const uint MODEL_TEMPLATE_WORDS = 56u;
const uint MODEL_FACE_WORDS = 9u;

const uint FACE_DOWN = 1u << 0u;
const uint FACE_UP = 1u << 1u;
const uint FACE_NORTH = 1u << 2u;
const uint FACE_SOUTH = 1u << 3u;
const uint FACE_WEST = 1u << 4u;
const uint FACE_EAST = 1u << 5u;

uint decodeFlags(uint base, uint flagsOffset, uint index) {
    uint flags = 0u;
    for (uint plane = 0u; plane < FLAG_PLANES; ++plane) {
        uint bits = inputPage.words[base + flagsOffset + plane * PLANE_WORDS + (index >> 5u)];
        flags |= ((bits >> (index & 31u)) & 1u) << plane;
    }
    return flags;
}

bool hasFlagPlane(uint base, uint flagsOffset, uint index, uint plane) {
    uint bits = inputPage.words[base + flagsOffset + plane * PLANE_WORDS + (index >> 5u)];
    return ((bits >> (index & 31u)) & 1u) != 0u;
}

bool isGpuFullCube(uint base, uint flagsOffset, uint index) {
    return hasFlagPlane(base, flagsOffset, index, GPU_FULL_CUBE_PLANE);
}

bool isSolidRender(uint base, uint flagsOffset, uint index) {
    return hasFlagPlane(base, flagsOffset, index, SOLID_RENDER_PLANE);
}

uint haloBit(uint index, uint face) {
    uint x = index & 15u;
    uint y = (index >> 4u) & 15u;
    uint z = (index >> 8u) & 15u;
    if (face <= 1u)
        return x | (z << 4u);
    if (face <= 3u)
        return x | (y << 4u);
    return z | (y << 4u);
}

bool boundaryNeighborSolidRender(uint base, uint haloOffset, uint index, uint face) {
    uint bit = haloBit(index, face);
    uint bits = inputPage.words[base + haloOffset + face * HALO_FACE_WORDS + (bit >> 5u)];
    return ((bits >> (bit & 31u)) & 1u) != 0u;
}

/*
 * This remains a conservative diagnostic candidate mask, not Minecraft's final
 * shouldRenderFace decision. GPU_FULL_CUBE only qualifies the source geometry.
 * Face rejection is stricter: an interior neighbor must carry Minecraft's
 * position-aware SOLID_RENDER result, and a section-edge neighbor must carry the
 * same semantic through the v4 one-block halo. That may retain faces which a more
 * specialized skipRendering/shape comparison could remove, but it no longer hides
 * a face merely because the neighbor has cube-shaped baked geometry.
 * CPU_REQUIRED remains authoritative.
 */
uint candidateFaceMask(uint base, uint flagsOffset, uint haloOffset, uint index) {
    if (!isGpuFullCube(base, flagsOffset, index))
        return 0u;

    uint x = index & 15u;
    uint y = (index >> 4u) & 15u;
    uint z = (index >> 8u) & 15u;
    uint mask = 0u;

    if (y == 0u) {
        if (!boundaryNeighborSolidRender(base, haloOffset, index, 0u)) mask |= FACE_DOWN;
    } else if (!isSolidRender(base, flagsOffset, index - 16u)) mask |= FACE_DOWN;
    if (y == 15u) {
        if (!boundaryNeighborSolidRender(base, haloOffset, index, 1u)) mask |= FACE_UP;
    } else if (!isSolidRender(base, flagsOffset, index + 16u)) mask |= FACE_UP;
    if (z == 0u) {
        if (!boundaryNeighborSolidRender(base, haloOffset, index, 2u)) mask |= FACE_NORTH;
    } else if (!isSolidRender(base, flagsOffset, index - 256u)) mask |= FACE_NORTH;
    if (z == 15u) {
        if (!boundaryNeighborSolidRender(base, haloOffset, index, 3u)) mask |= FACE_SOUTH;
    } else if (!isSolidRender(base, flagsOffset, index + 256u)) mask |= FACE_SOUTH;
    if (x == 0u) {
        if (!boundaryNeighborSolidRender(base, haloOffset, index, 4u)) mask |= FACE_WEST;
    } else if (!isSolidRender(base, flagsOffset, index - 1u)) mask |= FACE_WEST;
    if (x == 15u) {
        if (!boundaryNeighborSolidRender(base, haloOffset, index, 5u)) mask |= FACE_EAST;
    } else if (!isSolidRender(base, flagsOffset, index + 1u)) mask |= FACE_EAST;
    return mask;
}

/*
 * bit 31 marks a live candidate, bits 12..14 hold the face id, and bits 0..11
 * hold the section-local voxel index. Fixed slots preserve the deterministic
 * classification oracle; compact slots are the first dense GPU face-work list.
 */
uint encodeFaceDescriptor(uint index, uint face) {
    return 0x80000000u | (face << 12u) | index;
}

/* Five bits per axis are sufficient for section-grid coordinates 0..16. */
uint packCorner(uint x, uint y, uint z) {
    return x | (y << 5u) | (z << 10u);
}

/*
 * Expand one dense face-work item into the four corners of its unit-cube face.
 * The sequence matches Minecraft FaceInfo's exact baked-quad vertex order for
 * each direction. Model qualification now proves that positional order too;
 * UV orientation, light, tint, AO, and material are still not GPU-qualified.
 */
void writeFaceCorners(uint compactSlot, uint index, uint face) {
    uint x0 = index & 15u;
    uint y0 = (index >> 4u) & 15u;
    uint z0 = (index >> 8u) & 15u;
    uint x1 = x0 + 1u;
    uint y1 = y0 + 1u;
    uint z1 = z0 + 1u;
    uint base = FACE_VERTEX_BASE + compactSlot * VERTICES_PER_FACE;

    if (face == 0u) {
        outputData.words[base] = packCorner(x0, y0, z1);
        outputData.words[base + 1u] = packCorner(x0, y0, z0);
        outputData.words[base + 2u] = packCorner(x1, y0, z0);
        outputData.words[base + 3u] = packCorner(x1, y0, z1);
    } else if (face == 1u) {
        outputData.words[base] = packCorner(x0, y1, z0);
        outputData.words[base + 1u] = packCorner(x0, y1, z1);
        outputData.words[base + 2u] = packCorner(x1, y1, z1);
        outputData.words[base + 3u] = packCorner(x1, y1, z0);
    } else if (face == 2u) {
        outputData.words[base] = packCorner(x1, y1, z0);
        outputData.words[base + 1u] = packCorner(x1, y0, z0);
        outputData.words[base + 2u] = packCorner(x0, y0, z0);
        outputData.words[base + 3u] = packCorner(x0, y1, z0);
    } else if (face == 3u) {
        outputData.words[base] = packCorner(x0, y1, z1);
        outputData.words[base + 1u] = packCorner(x0, y0, z1);
        outputData.words[base + 2u] = packCorner(x1, y0, z1);
        outputData.words[base + 3u] = packCorner(x1, y1, z1);
    } else if (face == 4u) {
        outputData.words[base] = packCorner(x0, y1, z0);
        outputData.words[base + 1u] = packCorner(x0, y0, z0);
        outputData.words[base + 2u] = packCorner(x0, y0, z1);
        outputData.words[base + 3u] = packCorner(x0, y1, z1);
    } else {
        outputData.words[base] = packCorner(x1, y1, z1);
        outputData.words[base + 1u] = packCorner(x1, y0, z1);
        outputData.words[base + 2u] = packCorner(x1, y0, z0);
        outputData.words[base + 3u] = packCorner(x1, y1, z0);
    }
}

/*
 * Resolve one actual compact candidate descriptor through the current baked-model
 * state index. The zero-filled output remains the fail-closed sentinel when model
 * lookup is disabled or the voxel is not qualified by the current resource table.
 */
void writeModelFace(uint compactSlot, uint stateId, uint face) {
    if (pc.modelTemplateCount == 0u
            || modelTable.words[0] != MODEL_MAGIC
            || modelTable.words[1] != MODEL_VERSION
            || modelTable.words[5] != pc.modelTemplateCount)
        return;

    uint stateIndexCount = modelTable.words[4];
    if (stateId >= stateIndexCount)
        return;
    uint densePlusOne = modelTable.words[MODEL_HEADER_WORDS + stateId];
    if (densePlusOne == 0u || densePlusOne > pc.modelTemplateCount)
        return;

    uint templateBase = modelTable.words[7]
            + (densePlusOne - 1u) * MODEL_TEMPLATE_WORDS;
    uint faceBase = templateBase + 2u + face * MODEL_FACE_WORDS;
    uint outputBase = MODEL_FACE_BASE + compactSlot * MODEL_FACE_RESULT_WORDS;
    outputData.words[outputBase] = densePlusOne;
    for (uint word = 0u; word < MODEL_FACE_WORDS; ++word)
        outputData.words[outputBase + 1u + word] = modelTable.words[faceBase + word];
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= BLOCK_COUNT)
        return;

    uint base = pc.baseByteOffset >> 2u;
    bool validHeader = inputPage.words[base] == MAGIC
            && inputPage.words[base + 1u] == VERSION
            && inputPage.words[base + 2u] == pc.byteLength
            && inputPage.words[base + 3u] == BLOCK_COUNT
            && inputPage.words[base + 11u] == FLAG_PLANES
            && inputPage.words[base + 13u] == HALO_WORDS;
    if (!validHeader) {
        if (index == 0u)
            atomicOr(outputData.words[3], 0x80000000u);
        return;
    }

    uint paletteOffset = inputPage.words[base + 8u];
    uint indexOffset = inputPage.words[base + 9u];
    uint flagsOffset = inputPage.words[base + 10u];
    uint haloOffset = inputPage.words[base + 12u];

    uint packed = inputPage.words[base + indexOffset + (index >> 1u)];
    uint paletteIndex = (packed >> ((index & 1u) * 16u)) & 0xffffu;
    uint stateId = inputPage.words[base + paletteOffset + paletteIndex];
    uint flags = decodeFlags(base, flagsOffset, index);
    uint faceMask = candidateFaceMask(base, flagsOffset, haloOffset, index);
    uint faceCount = uint(bitCount(faceMask));

    atomicAdd(outputData.words[0], stateId);
    atomicAdd(outputData.words[1], flags);
    atomicAdd(outputData.words[2], ((stateId * 33u) ^ flags ^ index) ^ (faceMask * 0x9e3779b9u));
    uint compactBase = atomicAdd(outputData.words[3], faceCount);

    uint descriptorBase = HEADER_WORDS + index * FACES_PER_VOXEL;
    uint compactCursor = 0u;
    for (uint face = 0u; face < FACES_PER_VOXEL; ++face) {
        if ((faceMask & (1u << face)) == 0u)
            continue;

        uint compactSlot = compactBase + compactCursor;
        uint descriptor = encodeFaceDescriptor(index, face);
        outputData.words[descriptorBase + face] = descriptor;
        outputData.words[COMPACT_DESCRIPTOR_BASE + compactSlot] = descriptor;
        writeFaceCorners(compactSlot, index, face);
        writeModelFace(compactSlot, stateId, face);
        ++compactCursor;
    }
}
